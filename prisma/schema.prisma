generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id_role   Int    @id @default(autoincrement())
  type_role String @unique @db.VarChar(30)
  users     User[]

  @@map("role")
}

model Status {
  id_status   Int      @id @default(autoincrement())
  type_status String   @unique @db.VarChar(20)
  reports     Report[]

  @@map("status")
}

model User {
  id_user   Int       @id @default(autoincrement())
  dni       Int       @unique
  name      String    @db.VarChar(50)
  email     String    @unique @db.VarChar(100)
  password  String    @db.VarChar(100)
  telefono  String    @db.VarChar(15)
  is_active Boolean
  id_role   Int
  comments  Comment[]
  report    Report[]
  role      Role      @relation(fields: [id_role], references: [id_role])

  @@map("user")
}

model Type {
  id_type Int      @id @default(autoincrement())
  type    String   @unique @db.VarChar(20)
  reports Report[]

  @@map("type")
}

model Report {
  id_report     Int       @id @default(autoincrement())
  tracking_num  String    @unique @db.VarChar(10)
  description   String
  img_url       String?   @db.VarChar(250)
  date          DateTime  @default(now())
  id_type       Int
  id_status     Int
  id_user       Int
  street        String    @db.VarChar(100)
  street_number Int       @default(0)
  comments      Comment[]
  status        Status    @relation(fields: [id_status], references: [id_status])
  type          Type      @relation(fields: [id_type], references: [id_type])
  user          User      @relation(fields: [id_user], references: [id_user])

  @@map("report")
}

model Comment {
  id_comment Int      @id @default(autoincrement())
  text       String
  date       DateTime @default(now())
  id_report  Int
  id_user    Int
  report     Report   @relation(fields: [id_report], references: [id_report])
  user       User     @relation(fields: [id_user], references: [id_user])

  @@map("comment")
}
